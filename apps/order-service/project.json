{
  "name": "order-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/order-service/src",
  "projectType": "application",
  "tags": ["type:app", "scope:orders"],
  "targets": {
    "prisma-generate": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{workspaceRoot}/prisma.config.ts"
      ],
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "options": {
        "command": "prisma generate",
        "cwd": "{workspaceRoot}"
      }
    },
    "prisma-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/order-service"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "order-service:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "order-service:build:development"
        },
        "production": {
          "buildTarget": "order-service:build:production"
        }
      }
    },
    "test": {
      "dependsOn": ["prisma-generate"]
    }
  }
}
